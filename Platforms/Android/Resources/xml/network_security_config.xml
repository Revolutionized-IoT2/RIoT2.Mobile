<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard URL is user-configurable and the controller UI is served over HTTP on an isolated
     LAN (ADR 0002). Android can't scope cleartext to IP ranges, so it is allowed for every host. -->
<network-security-config>
	<base-config cleartextTrafficPermitted="true">
		<trust-anchors>
			<certificates src="system" />
		</trust-anchors>
	</base-config>
</network-security-config>
